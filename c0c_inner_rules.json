{
  "version": "1.0",
  "description": "设备内部连接规则配置",
  "allowedDeviceTypes": ["K", "Q", "S"],
  "defaultConnectionProperties": {
    "voltage": 24.0,
    "current": 0.1,
    "resistance": 240.0,
    "isCable": false,
    "isInPanel": true,
    "connType": "devInConn"
  },
  "deviceRules": {
    "K": {
      "description": "继电器连接规则",
      "subtypes": {
        "K2": {
          "pattern": "^K2",
          "connections": [
            {
              "type": "coil",
              "points": ["A1", "A2"],
              "properties": {
                "connType": "coil"
              }
            },
            {
              "type": "contacts",
              "pairs": [
                {
                  "nc": ["42", "41"],
                  "no": ["41", "44"]
                },
                {
                  "nc": ["32", "31"],
                  "no": ["31", "34"]
                },
                {
                  "nc": ["22", "21"],
                  "no": ["21", "24"]
                },
                {
                  "nc": ["12", "11"],
                  "no": ["11", "14"]
                }
              ],
              "properties": {
                "voltage": 24.0,
                "current": 0.1,
                "resistance": 240.0,
                "isCable": false,
                "isInPanel": true
              }
            }
          ]
        },
        "default": {
          "pattern": "^K",
          "connections": [
            {
              "type": "coil",
              "points": ["A11", "A12"],
              "properties": {
                "connType": "coil"
              }
            },
            {
              "type": "contacts",
              "pattern_pairs": [
                {
                  "nc": {
                    "pattern": ["(\\d+)1", "\\g<1>2"],
                    "examples": ["11-12", "71-72"]
                  }
                },
                {
                  "nc": {
                    "pattern": ["(\\d+)3", "\\g<1>4"],
                    "examples": ["23-24"]
                  }
                }
              ],
              "properties": {
                "voltage": 24.0,
                "current": 0.1,
                "resistance": 240.0,
                "isCable": false,
                "isInPanel": true,
                "connType": "NC"
              }
            }
          ]
        }
      }
    },
    "Q": {
      "description": "Q类设备规则",
      "connections": [
        {
          "type": "coil",
          "points": ["D1", "D2"],
          "properties": {
            "connType": "coil"
          }
        },
        {
          "type": "contacts",
          "pairs": [
            {
              "no": ["L1", "T1"]
            },
            {
              "no": ["L2", "T2"]
            },
            {
              "no": ["L3", "T3"]
            }
          ],
          "properties": {
            "voltage": 24.0,
            "current": 0.1,
            "resistance": 240.0,
            "isCable": false,
            "isInPanel": true,
            "connType": "NO"
          }
        }
      ]
    },
    "S": {
      "description": "S类设备规则",
      "connections": [
        {
          "type": "contacts",
          "pairs": [
            {
              "snc": ["1", "2"],
              "sno": ["3", "4"]
            }
          ],
          "variants": {
            "1-4_only": [
              {
                "snc": ["1", "4"]
              }
            ],
            "with_postfix": [
              {
                "snc": [".1", ".2"]
              }
            ]
          },
          "properties": {
            "voltage": 24.0,
            "current": 0.1,
            "resistance": 240.0,
            "isCable": false,
            "isInPanel": true
          }
        }
      ]
    }
  }
}